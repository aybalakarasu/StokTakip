@model List<StokTakip.Web.ViewModels.KategoriViewModel>
@{
    ViewData["Title"] = "Kategoriler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Kategoriler</h2>
    <a asp-action="Ekle" class="btn btn-primary">Yeni Kategori Ekle</a>
</div>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Kategori Adı</th>
                    <th>Ürün Sayısı</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kategori in Model)
                {
                    <tr>
                        <td>@kategori.Id</td>
                        <td>@kategori.Ad</td>
                        <td><span class="badge bg-info">@kategori.UrunSayisi</span></td>
                        <td>
                            <a asp-action="Duzenle" asp-route-id="@kategori.Id" class="btn btn-sm btn-warning">Düzenle</a>
                            <form asp-action="Sil" asp-route-id="@kategori.Id" method="post" class="d-inline" onsubmit="return confirm('Bu kategoriyi silmek istediğinizden emin misiniz?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        Henüz kategori eklenmemiş. <a asp-action="Ekle">İlk kategoriyi eklemek için tıklayın.</a>
    </div>
}

