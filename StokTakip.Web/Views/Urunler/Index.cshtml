@model List<StokTakip.Web.ViewModels.UrunViewModel>
@{
    ViewData["Title"] = "Ürünler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Ürünler</h2>
    <a asp-action="Ekle" class="btn btn-primary">Yeni Ürün Ekle</a>
</div>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Ürün Adı</th>
                    <th>Kategori</th>
                    <th>Stok</th>
                    <th>Fiyat</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var urun in Model)
                {
                    <tr>
                        <td>@urun.Id</td>
                        <td>@urun.Ad</td>
                        <td>@urun.KategoriAdi</td>
                        <td>
                            @if (urun.Stok < 10)
                            {
                                <span class="badge bg-warning">@urun.Stok</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@urun.Stok</span>
                            }
                        </td>
                        <td>@urun.Fiyat.ToString("C2")</td>
                        <td>
                            <a asp-action="Detay" asp-route-id="@urun.Id" class="btn btn-sm btn-info">Detay</a>
                            <a asp-action="Duzenle" asp-route-id="@urun.Id" class="btn btn-sm btn-warning">Düzenle</a>
                            <form asp-action="Sil" asp-route-id="@urun.Id" method="post" class="d-inline" onsubmit="return confirm('Bu ürünü silmek istediğinizden emin misiniz?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        Henüz ürün eklenmemiş. <a asp-action="Ekle">İlk ürünü eklemek için tıklayın.</a>
    </div>
}

